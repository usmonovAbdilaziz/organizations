// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique // Telefon raqami uchun String yaxshi (masalan: +998...)
  username     String   @unique
  passwordHash String?
  passwordSalt String?
  fullName     String?
  telegramId   String?  @unique
  role         UserRole @default(CLIENT)

  organizationId String? // Agar foydalanuvchi biror tashkilotga tegishli bo'lsa
  branchId       String? // Agar foydalanuvchi aniq bir filialda ishlasa

  // Relations
  organization  Organization?  @relation(fields: [organizationId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  recoveryTokens RecoveryToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model RecoveryToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Organization {
  id           String                @id @default(cuid())
  name         String
  type         OrganizationType      @default(RESTAURANT)
  description  String?               @db.Text
  logo         String? // Logo uchun URL
  website      String?
  inn          Int? // TIN (Tax Identification Number)
  orgStructure OrganizationStructure @default(MCHJ) // Tashkilot tuzilishi (masalan: "LLC", "JSC", "Sole Proprietorship")
  isActive     Boolean               @default(true)

  // Bog'liqliklar
  users      User[] // Tashkilot egalari/adminlari
  branches   Branch[] // Tashkilot filiallari
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id      String  @id @default(cuid())
  name    String // Filial nomi (masalan: "Chilonzor filiali")
  address String? // To'liq manzili

  // Geolokatsiya
  lat          Float // Latitude (Kenglik)
  long         Float // Longitude (Uzunlik)
  code         Int // Filial kodi (masalan: 101, 102, ...)
  // Aloqa
  phone        String?
  workingHours String? // Masalan: "09:00-22:00"

  // Bog'liqliklar
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  staff          User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String  @id @default(cuid()) //id
  name String //categoriya nomi Restoran Mehmonxona Dorixona Universitet
  slug String  @unique // URL uchun (masalan: "milliy-taomlar") URL uchun ishlatiladi. Har doim unikal bo'lishi kerak.
  icon String? // Categoriya uchun rasm yoki icon nomi.Kategoriya ikonkasini saqlaydi.
  image String? //categoriya rasmi

  isActive Boolean @default(true)//categoriya faoliyati
  order    Int     @default(0) //categoriyalar tartibi. Chiqarilish tartibini belgilaydi.orderBy: { order: "asc"}
  // O'z-o'ziga bog'liqlik (Parent-Child)
  parentId      String? // parent qilish
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")

  // Tashkilotlar bilan bog'liqlik
  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganizationStructure {
  MCHJ
  YATT
  AJ
  XK
  QK
  NNT
  DM
  DUK
  MU
  FILIAL
}

//enums
//user
enum UserRole {
  SUPER_ADMIN // Tizim egasi (Siz)
  ORGANIZATION //Tashkilotlar egasi
  DIRECTOR // Tashkilot direktori
  ADMIN // Tashkilot egasi (Owner)
  MANAGER // Filial menejeri
  KASSIR // Kassir
  WAITER // Ofitsant
  RUNNER // Runner
  CLIENT // Oddiy mijoz (CLIENT)
}

//organization
enum OrganizationType {
  RESTAURANT
  MEDICAL
  RETAIL
  EDUCATION
  OTHER
}
